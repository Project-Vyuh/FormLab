VITE_BACKEND_PROVIDER=local
VITE_AI_PROVIDER=gemini
VITE_VIDEO_PROVIDER=disabled
VITE_API_BASE_URL=

# Server-only configuration. Never use VITE_ for secrets.
FORMLAB_AI_PROVIDER=gemini
FORMLAB_DEPLOYMENT_MODE=local
FORMLAB_DB_PROVIDER=sqlite
FORMLAB_AUTH_PROVIDER=local
FORMLAB_STORAGE_PROVIDER=filesystem
FORMLAB_API_PORT=8787
FORMLAB_VIDEO_ENABLED=false
FORMLAB_WORKERS=2
FORMLAB_DAILY_JOB_LIMIT=50
FORMLAB_PENDING_JOB_LIMIT=10
FORMLAB_MAX_ASSET_BYTES=20971520
FORMLAB_USER_STORAGE_BYTES=1073741824
FORMLAB_MEMORY_BUDGET_BYTES=536870912
FORMLAB_MAX_RSS_BYTES=805306368
FORMLAB_DAILY_BUDGET_UNITS=100
# Disabled by default to preserve existing data. Preview cleanup before enabling.
FORMLAB_RETENTION_ENABLED=false
FORMLAB_JOB_RETENTION_DAYS=30
FORMLAB_ORPHAN_RETENTION_DAYS=7
FORMLAB_TRASH_RETENTION_DAYS=7
FORMLAB_ALLOW_REGISTRATION=false
# FORMLAB_DATA_DIR=/absolute/path/to/local/data
GEMINI_API_KEY=
# Optional external secret file, loaded only by the backend/dev runner:
# FORMLAB_ENV_FILE=/absolute/path/to/private.env

# Optional legacy Firebase mode; not required for local development.
# VITE_BACKEND_PROVIDER=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
